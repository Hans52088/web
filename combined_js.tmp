let layoutRows=[['1','2','3','4','5','6','7','8','9','0'],['q','w','e','r','t','y','u','i','o','p'],['a','s','d','f','g','h','j','k','l'],['shift','z','x','c','v','b','n','m','comma','period','slash'],['numeric','tildedirect','space','perioddirect','backspace','enter']];
let swipeData={swipe_up:{},swipe_down:{}};
let hintSymbolsData={alphabetic:{},pinyin:{}};
let currentSelectedKey=null;let currentCategory='both';let activeCodeTab='swipe';let currentEditorMode='swipe';
let step2Loaded=false;let step3Loaded=false;let internalClipboard={swipe:"",hint:""};let longPressTimer=null;
let fileNames={swipe:'swipeData.libsonnet',hint:'hintSymbolsData.libsonnet'};
let defaultBgMap={'alphabeticBackgroundStyle':'#ffffff','systemButtonBackgroundStyle':'#e5e5ea','searchButtonBackgroundStyle':'#007aff'};
const noValueCommands=['backspace','enter','shift','tab','space','nextKeyboard','characterMargin','none'];
const presetShortcuts={'shortcut_undo':'#undo','shortcut_deleteText':'#deleteText','shortcut_copy':'#copy','shortcut_paste':'#paste','shortcut_cut':'#cut','shortcut_selectText':'#selectText','shortcut_home':'#行首','shortcut_end':'#行尾','shortcut_onehanded':'#左手模式','shortcut_rime2':'#次选上屏','shortcut_rime3':'#三选上屏'};
const reverseShortcutMap={};for(let key in presetShortcuts)reverseShortcutMap[presetShortcuts[key]]=key;
const shortCommandsGroups=[{group:'輸入法控制',options:[{value:'#中英切换',label:'中英切換'},{value:'#方案切换',label:'方案切換'},{value:'#重输',label:'重輸'},{value:'#清空',label:'清空'}]},{group:'編輯選取',options:[{value:'#撤销',label:'撤銷'},{value:'#剪切',label:'剪切'},{value:'#复制',label:'複製'},{value:'#粘贴',label:'貼上'},{value:'#全选',label:'全選'}]},{group:'游標移動',options:[{value:'#左移',label:'左移'},{value:'#右移',label:'右移'},{value:'#行首',label:'行首'},{value:'#行尾',label:'行尾'}]},{group:'系統功能',options:[{value:'#隐藏键盘',label:'隱藏鍵盤'},{value:'#左手键盘',label:'左手鍵盤'},{value:'#语音输入',label:'語音輸入'}]}];
const keyboardTypesList=[{value:'alphabetic',label:'英文鍵盤 (alphabetic)'},{value:'pinyin',label:'中文鍵盤 (pinyin)'},{value:'numeric',label:'數字 (numeric)'},{value:'symbolic',label:'符號 (symbolic)'}];
const sfSymbolEmojiMap={'globe':'🌐','delete.left':'⌫','trash':'🗑️','shift':'⇧','return':'⏎','keyboard.onehanded.left':'👈','keyboard.onehanded.right':'👉','space':'␣','arrow.uturn.backward':'↩️','doc.on.doc':'📄','doc.on.clipboard':'📋','scissors':'✂️','arrow.left.to.line':'⇤','arrow.right.to.line':'⇥','square.dashed':'⬚','2.circle':'②','3.circle':'③'};
const sfSymbolsList=[{name:'keyboard',visual:'⌨️',desc:'鍵盤'},{name:'return',visual:'⏎',desc:'換行'},{name:'delete.left',visual:'⌫',desc:'刪除'},{name:'shift',visual:'⇧',desc:'Shift'},{name:'space',visual:'␣',desc:'空白鍵'},{name:'globe',visual:'🌐',desc:'地球'},{name:'gear',visual:'⚙️',desc:'設定'},{name:'arrow.left.to.line',visual:'⇤',desc:'行首'},{name:'arrow.right.to.line',visual:'⇥',desc:'行尾'},{name:'scissors',visual:'✂️',desc:'剪切'},{name:'doc.on.clipboard',visual:'📋',desc:'貼上'},{name:'doc.on.doc',visual:'📄',desc:'複製'}];
const commandToSfMap={'shortcut_undo':'sf:arrow.uturn.backward','shortcut_deleteText':'sf:delete.left','shortcut_copy':'sf:doc.on.doc','shortcut_paste':'sf:doc.on.clipboard','shortcut_cut':'sf:scissors','shortcut_selectText':'sf:square.dashed','shortcut_home':'sf:arrow.left.to.line','shortcut_end':'sf:arrow.right.to.line','shortcut_onehanded':'sf:keyboard.onehanded.left','shortcut_rime2':'sf:2.circle','shortcut_rime3':'sf:3.circle','backspace':'sf:delete.left','enter':'sf:return','shift':'sf:shift','space':'sf:space','nextKeyboard':'sf:globe'};
let currentIconTargetIndex=null;
function renderIconGrid(){const grid=document.getElementById('iconGrid');grid.innerHTML='';sfSymbolsList.forEach(icon=>{const div=document.createElement('div');div.className='icon-cell';div.onclick=()=>selectIcon(icon.name);div.innerHTML=`<div style="font-size:24px;">${icon.visual}</div><div style="font-size:13px;font-weight:600;">${icon.desc}</div>`;grid.appendChild(div);});}
function openIconModal(index){currentIconTargetIndex=index;document.getElementById('iconModalOverlay').style.display='flex';}
function closeIconModal(){document.getElementById('iconModalOverlay').style.display='none';currentIconTargetIndex=null;}
function selectIcon(iconName){if(currentIconTargetIndex!==null){if(currentEditorMode==='hint'){updateHintItemLabel(currentIconTargetIndex,'sf:'+iconName);}}closeIconModal();}

function showPopup(keyElement,keyChar){const activeCat=currentCategory==='both'?'alphabetic':currentCategory;if(!hintSymbolsData[activeCat]||!hintSymbolsData[activeCat][keyChar])return;const keyData=hintSymbolsData[activeCat][keyChar];if(!keyData.list||keyData.list.length===0)return;let popup=document.getElementById('keyPopup');popup.innerHTML='';keyData.list.forEach((item,index)=>{const div=document.createElement('div');div.className='popup-item';if(index===(keyData.selectedIndex||0)){div.classList.add('selected');}let text='';if(item.label&&item.label.systemImageName){text=sfSymbolEmojiMap[item.label.systemImageName]||'❖';}else if(item.label&&item.label.text!==""&&item.label.text!==undefined){text=item.label.text;}else if(item.action){if(item.action.symbol)text=item.action.symbol;else if(item.action.character)text=item.action.character;else if(item.action.shortcut)text='⚙️';else if(item.action.keyboardType)text='⌨️';else text='❖';}else{text='❖';}div.innerText=text;if(keyData.size&&keyData.size.width){div.style.minWidth=keyData.size.width+'px';div.style.width=keyData.size.width+'px';}popup.appendChild(div);});const rect=keyElement.getBoundingClientRect();popup.style.left=(rect.left+rect.width/2)+'px';popup.style.top=(rect.top-8)+'px';popup.classList.add('show');}
function hidePopup(){const popup=document.getElementById('keyPopup');if(popup){popup.classList.remove('show');}}

function bindColorInputs(colorId,textId){const colorEl=document.getElementById(colorId);const textEl=document.getElementById(textId);colorEl.addEventListener('input',(e)=>textEl.value=e.target.value.toUpperCase());textEl.addEventListener('input',(e)=>{let val=e.target.value.trim();if(val.match(/^#[0-9A-Fa-f]{6}$/i))colorEl.value=val.toLowerCase();});}

function extractKeyName(cellName){if(!cellName)return null;let name=cellName.replace(/Button/i,'').trim().toLowerCase();const map={'one':'1','two':'2','three':'3','four':'4','five':'5','six':'6','seven':'7','eight':'8','nine':'9','zero':'0','semicolon':';','slash':'/','comma':'comma','period':'period','tildedirect':'tildedirect','perioddirect':'perioddirect','spacedirect':'space','backspacedirect':'backspace','shiftdirect':'shift','numericdirect':'numeric','enterdirect':'enter'};return map[name]||name;}
function parseStep1Safe(text){let extractedRows=[];const hstackRegex=/HStack:\s*\{\s*subviews:\s*\[([\s\S]*?)\]\s*\}/g;let match;while((match=hstackRegex.exec(text))!==null){const cellsMatch=match[1].match(/Cell:\s*['"]([^'"]+)['"]/g);if(cellsMatch)extractedRows.push(cellsMatch.map(c=>c.match(/Cell:\s*['"]([^'"]+)['"]/)[1]));}if(extractedRows.length>0)layoutRows=extractedRows;const colorRegex=/['"]([^'"]+)['"]\+?:\s*\{\s*[\s\S]*?normalColor:\s*['"]([^'"]+)['"]/g;let cMatch;while((cMatch=colorRegex.exec(text))!==null){if(cMatch[1].includes('BackgroundStyle'))defaultBgMap[cMatch[1]]=cMatch[2];}}
function migrateOldCommands(data){if(!data)return;Object.keys(data).forEach(category=>{if(data[category]&&typeof data[category]==='object'){Object.keys(data[category]).forEach(key=>{const keyData=data[category][key];if(keyData&&keyData.list&&Array.isArray(keyData.list)){keyData.list.forEach(item=>{if(item.action&&typeof item.action==='object'){if(item.action.shortCommand!==undefined){item.action.shortcut=item.action.shortCommand;delete item.action.shortCommand;}}if(!item.label){item.label={text:""};}});}});}});}
function parseDataFile(text){let cleanText=text.replace(/\/\/.*$/gm,'').replace(/\/\*[\s\S]*?\*\//g,'').replace(/,\s*([}\]])/g,'$1');return new Function("return ("+cleanText+");")();}

function renderKeyboard(){const area=document.getElementById('keyboardRenderContainer');area.innerHTML='';let keyboardCount=0;let isNewKeyboard=true;layoutRows.forEach(row=>{if(isNewKeyboard){const labelDiv=document.createElement('div');labelDiv.style.cssText='width:100%;text-align:center;font-weight:bold;color:var(--text-secondary);font-size:14px;margin-bottom:10px;'+(keyboardCount>0?'margin-top:25px;':'');labelDiv.innerText=keyboardCount===0?'📱 豎屏 (Portrait) 配置':'🖥️ 橫屏 (Landscape) 配置';area.appendChild(labelDiv);keyboardCount++;isNewKeyboard=false;}const rowDiv=document.createElement('div');rowDiv.className='keyboard-row';row.forEach(cellName=>{let keyChar=extractKeyName(cellName);if(!keyChar)return;const keyBtn=document.createElement('div');keyBtn.className='key';keyBtn.id='key-'+keyChar;let bgStyle='alphabeticBackgroundStyle';if(['backspace','enter','shift','numeric','space'].includes(keyChar))bgStyle='systemButtonBackgroundStyle';if(keyChar==='enter'||keyChar==='search')bgStyle='searchButtonBackgroundStyle';keyBtn.style.backgroundColor=defaultBgMap[bgStyle];if(keyChar==='enter'||keyChar==='search')keyBtn.style.color='#ffffff';let displayChar=keyChar;if(keyChar==='space'){keyBtn.style.flex='4';keyBtn.style.maxWidth='180px';displayChar='空白鍵';}else if(keyChar==='backspace'){keyBtn.style.flex='1.5';keyBtn.style.maxWidth='80px';displayChar='⌫';}else if(keyChar==='shift'){keyBtn.style.flex='1.5';keyBtn.style.maxWidth='80px';displayChar='⇧';}else if(keyChar==='numeric'){keyBtn.style.flex='1.5';keyBtn.style.maxWidth='80px';displayChar='123';}else if(keyChar==='enter'||keyChar==='search'){keyBtn.style.flex='2';keyBtn.style.maxWidth='100px';displayChar='Enter';}else if(keyChar.includes('tilde')){keyBtn.style.flex='1';displayChar='~';}else if(keyChar.includes('perioddirect')){keyBtn.style.flex='1';displayChar='.';}else if(keyChar==='comma')displayChar=',';else if(keyChar==='period')displayChar='.';else if(keyChar===';')displayChar=';';else if(keyChar==='/')displayChar='/';keyBtn.innerText=displayChar;
        const upData=swipeData.swipe_up[keyChar];if(upData&&upData.label){const s=document.createElement('span');s.className='swipe-label swipe-up-label';s.innerText=upData.label.systemImageName?(sfSymbolEmojiMap[upData.label.systemImageName]||'❖'):(upData.label.text||'');if(upData.fontSize)s.style.fontSize=upData.fontSize+'px';let c2=upData.normalColor||upData.label.color;if(c2)s.style.color=c2;keyBtn.appendChild(s);}
        const downData=swipeData.swipe_down[keyChar];if(downData&&downData.label){const s=document.createElement('span');s.className='swipe-label swipe-down-label';s.innerText=downData.label.systemImageName?(sfSymbolEmojiMap[downData.label.systemImageName]||'❖'):(downData.label.text||'');if(downData.fontSize)s.style.fontSize=downData.fontSize+'px';let c2=downData.normalColor||downData.label.color;if(c2)s.style.color=c2;keyBtn.appendChild(s);}
        let hasHint=false;if(currentCategory==='both'){hasHint=(hintSymbolsData.alphabetic&&hintSymbolsData.alphabetic[keyChar]&&hintSymbolsData.alphabetic[keyChar].list.length>0)||(hintSymbolsData.pinyin&&hintSymbolsData.pinyin[keyChar]&&hintSymbolsData.pinyin[keyChar].list.length>0);}else{hasHint=hintSymbolsData[currentCategory]&&hintSymbolsData[currentCategory][keyChar]&&hintSymbolsData[currentCategory][keyChar].list.length>0;}if(hasHint)keyBtn.classList.add('has-hint');
        keyBtn.onclick=()=>selectKey(keyChar);keyBtn.onmousedown=(e)=>{if(e.button!==0)return;longPressTimer=setTimeout(()=>showPopup(keyBtn,keyChar),350);};keyBtn.onmouseup=()=>{clearTimeout(longPressTimer);hidePopup();};keyBtn.onmouseleave=()=>{clearTimeout(longPressTimer);hidePopup();};keyBtn.ontouchstart=()=>{longPressTimer=setTimeout(()=>showPopup(keyBtn,keyChar),350);};keyBtn.ontouchend=()=>{clearTimeout(longPressTimer);hidePopup();};keyBtn.ontouchcancel=()=>{clearTimeout(longPressTimer);hidePopup();};keyBtn.oncontextmenu=(e)=>{e.preventDefault();return false;};
        rowDiv.appendChild(keyBtn);});area.appendChild(rowDiv);let hasSpace=row.some(c=>extractKeyName(c)==='space');if(hasSpace){isNewKeyboard=true;}});if(currentSelectedKey&&document.getElementById('key-'+currentSelectedKey)){document.getElementById('key-'+currentSelectedKey).classList.add('selected');}}

function switchCategory(cat){if(currentSelectedKey)silentSaveCurrentKey();currentCategory=cat;document.getElementById('btn-both').className=cat==='both'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('btn-pinyin').className=cat==='pinyin'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('btn-alphabetic').className=cat==='alphabetic'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';currentSelectedKey=null;document.getElementById('editorArea').style.opacity='0.5';document.getElementById('editorArea').style.pointerEvents='none';document.getElementById('currentKeyDisplay').innerText='-';renderKeyboard();}
function switchEditorMode(mode){currentEditorMode=mode;document.getElementById('editorModeSwipe').className=mode==='swipe'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('editorModeHint').className=mode==='hint'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('swipeEditorSection').style.display=mode==='swipe'?'block':'none';document.getElementById('hintEditorSection').style.display=mode==='hint'?'block':'none';document.getElementById('copyPastePanelSwipe').style.display=mode==='swipe'?'flex':'none';document.getElementById('copyPastePanelHint').style.display=mode==='hint'?'flex':'none';document.getElementById('categoryTabs').style.display=mode==='hint'?'flex':'none';switchCodeTab(mode);}

function selectKey(keyChar){if(currentSelectedKey&&currentSelectedKey!==keyChar)silentSaveCurrentKey();currentSelectedKey=keyChar;renderKeyboard();let displayName=keyChar.toUpperCase();if(keyChar==='perioddirect')displayName='. (符號)';else if(keyChar==='comma')displayName=', (COMMA)';else if(keyChar==='period')displayName='. (PERIOD)';else if(keyChar===';')displayName='; (SEMICOLON)';else if(keyChar==='/')displayName='/ (SLASH)';document.getElementById('currentKeyDisplay').innerText=`${displayName}`;document.getElementById('editorArea').style.opacity='1';document.getElementById('editorArea').style.pointerEvents='auto';setupSwipePanel('up',swipeData.swipe_up[keyChar]||{});setupSwipePanel('down',swipeData.swipe_down[keyChar]||{});if(!hintSymbolsData.alphabetic)hintSymbolsData.alphabetic={};if(!hintSymbolsData.pinyin)hintSymbolsData.pinyin={};if(currentCategory==='both'){if(!hintSymbolsData.alphabetic[keyChar])hintSymbolsData.alphabetic[keyChar]={selectedIndex:0,list:[]};if(!hintSymbolsData.pinyin[keyChar])hintSymbolsData.pinyin[keyChar]={selectedIndex:0,list:[]};}else{if(!hintSymbolsData[currentCategory][keyChar])hintSymbolsData[currentCategory][keyChar]={selectedIndex:0,list:[]};}const activeCat=currentCategory==='both'?'alphabetic':currentCategory;document.getElementById('selectedIndexInput').value=hintSymbolsData[activeCat][keyChar].selectedIndex||0;const widthInput=document.getElementById('hintWidthInput');if(hintSymbolsData[activeCat][keyChar].size&&hintSymbolsData[activeCat][keyChar].size.width){widthInput.value=hintSymbolsData[activeCat][keyChar].size.width;}else{widthInput.value='';}renderHintItems();}

function updateSfPreview(prefix){const val=document.getElementById(prefix+'Label').value.trim();const box=document.getElementById(prefix+'SfPreview');if(val.toLowerCase().startsWith('sf:'))box.innerText=sfSymbolEmojiMap[val.substring(3).trim()]||'❖';else if(val.length>0)box.innerText=Array.from(val)[0];else box.innerText='';}
function autoFillSf(prefix){const typeVal=document.getElementById(prefix+'Type').value;const labelInput=document.getElementById(prefix+'Label');if(commandToSfMap[typeVal])labelInput.value=commandToSfMap[typeVal];else labelInput.value='';updateSfPreview(prefix);}
function handleTypeChange(prefix){const typeVal=document.getElementById(prefix+'Type').value;const symbolInput=document.getElementById(prefix+'Symbol');if(noValueCommands.includes(typeVal)||typeVal.startsWith('shortcut_')){symbolInput.disabled=true;symbolInput.value='';}else symbolInput.disabled=false;}
function setupSwipePanel(prefix,data){let type="none",val="",labelText="";if(data.action){if(typeof data.action==='string'){if(noValueCommands.includes(data.action))type=data.action;else{type="symbol";val=data.action;}}else if(typeof data.action==='object'){if(data.action.shortcut){if(reverseShortcutMap[data.action.shortcut])type=reverseShortcutMap[data.action.shortcut];else{type="shortcut";val=data.action.shortcut;}}else if(data.action.character){type="character";val=data.action.character;}else if(data.action.symbol){type="symbol";val=data.action.symbol;}else if(data.action.sendKeys){type="sendKeys";val=data.action.sendKeys;}else if(data.action.keyboardType){type="keyboardType";val=data.action.keyboardType;}}}if(data.label){if(data.label.systemImageName)labelText="sf:"+data.label.systemImageName;else labelText=data.label.text||'';}document.getElementById(prefix+'Type').value=type;document.getElementById(prefix+'Symbol').value=val;document.getElementById(prefix+'Label').value=labelText;const sizeInput=document.getElementById(prefix+'Size');sizeInput.value=data.fontSize||'';let colorVal=data.normalColor||data.label?.color||'#8e8e93';document.getElementById(prefix+'Color').value=colorVal;document.getElementById(prefix+'ColorText').value=colorVal.toUpperCase();handleTypeChange(prefix);updateSfPreview(prefix);}
function buildSwipeNode(prefix,existingData){const type=document.getElementById(prefix+'Type').value;const val=document.getElementById(prefix+'Symbol').value.trim();const labelText=document.getElementById(prefix+'Label').value.trim();const size=document.getElementById(prefix+'Size').value;const color=document.getElementById(prefix+'Color').value;if(type==='none'&&!labelText)return null;let node=existingData?JSON.parse(JSON.stringify(existingData)):{action:{},label:{}};if(!node.label)node.label={};delete node.action;if(type!=='none'){if(noValueCommands.includes(type))node.action=type;else if(type.startsWith('shortcut_'))node.action={"shortcut":presetShortcuts[type]};else if(val){node.action={};node.action[type]=val;}}if(labelText){if(labelText.toLowerCase().startsWith('sf:')){node.label.systemImageName=labelText.substring(3).trim();delete node.label.text;}else{node.label.text=labelText;delete node.label.systemImageName;}}else{delete node.label.text;delete node.label.systemImageName;}if(size)node.fontSize=parseInt(size);else delete node.fontSize;if(color&&color.toLowerCase()!=='#8e8e93'){node.normalColor=node.highlightColor=color;}else{delete node.normalColor;delete node.highlightColor;if(node.label&&node.label.color)delete node.label.color;}if(Object.keys(node.label).length===0){node.label={text:""};}if(!node.action&&(!node.label||(node.label.text===""&&!node.label.systemImageName))&&!node.fontSize&&!node.normalColor)return null;return node;}
/* ======================================================================
   PART 2b: Hint logic, save, code output, file handling, initialization
   ====================================================================== */
window.updateSelectedIndex=function(val){if(!currentSelectedKey)return;const idx=parseInt(val)||0;const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(hintSymbolsData[cat]&&hintSymbolsData[cat][currentSelectedKey]){hintSymbolsData[cat][currentSelectedKey].selectedIndex=idx;}});};
window.updateHintWidth=function(val){if(!currentSelectedKey)return;const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];const widthVal=parseInt(val);cats.forEach(cat=>{if(hintSymbolsData[cat]&&hintSymbolsData[cat][currentSelectedKey]){if(widthVal>0){hintSymbolsData[cat][currentSelectedKey].size={width:widthVal,height:53};}else{delete hintSymbolsData[cat][currentSelectedKey].size;}}});};

let draggedHintIndex=null;
window.handleDragStart=function(e,index){draggedHintIndex=index;setTimeout(()=>{e.target.closest('.hint-item').classList.add('dragging');},0);e.dataTransfer.effectAllowed='move';};
window.handleDragOver=function(e,index){e.preventDefault();e.dataTransfer.dropEffect='move';if(draggedHintIndex===null||draggedHintIndex===index)return;const item=e.target.closest('.hint-item');if(item){const rect=item.getBoundingClientRect();const midY=rect.top+rect.height/2;document.querySelectorAll('.hint-item').forEach(el=>{el.style.borderTop='';el.style.borderBottom='';});if(e.clientY<midY){item.style.borderTop='2px solid var(--ios-blue)';}else{item.style.borderBottom='2px solid var(--ios-blue)';}}};
window.handleDragLeave=function(e){const item=e.target.closest('.hint-item');if(item){item.style.borderTop='';item.style.borderBottom='';}};
window.handleDrop=function(e,targetIndex){e.preventDefault();document.querySelectorAll('.hint-item').forEach(el=>{el.classList.remove('dragging');el.style.borderTop='';el.style.borderBottom='';});if(draggedHintIndex===null||draggedHintIndex===targetIndex)return;const item=e.target.closest('.hint-item');let finalTargetIndex=targetIndex;if(item){const rect=item.getBoundingClientRect();const midY=rect.top+rect.height/2;if(e.clientY>midY&&draggedHintIndex<targetIndex){}else if(e.clientY<midY&&draggedHintIndex>targetIndex){}else if(e.clientY>midY&&draggedHintIndex>targetIndex){finalTargetIndex++;}else if(e.clientY<midY&&draggedHintIndex<targetIndex){finalTargetIndex--;}}const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(hintSymbolsData[cat]&&hintSymbolsData[cat][currentSelectedKey]&&hintSymbolsData[cat][currentSelectedKey].list){const list=hintSymbolsData[cat][currentSelectedKey].list;const movedItem=list.splice(draggedHintIndex,1)[0];list.splice(finalTargetIndex,0,movedItem);}});draggedHintIndex=null;renderHintItems();};
window.handleDragEnd=function(e){document.querySelectorAll('.hint-item').forEach(el=>{el.classList.remove('dragging');el.style.borderTop='';el.style.borderBottom='';});draggedHintIndex=null;};

function renderHintItems(){const container=document.getElementById('hintItemsContainer');container.innerHTML='';const activeCat=currentCategory==='both'?'alphabetic':currentCategory;if(!hintSymbolsData[activeCat]||!hintSymbolsData[activeCat][currentSelectedKey])return;const dataList=hintSymbolsData[activeCat][currentSelectedKey].list||[];if(dataList.length===0){container.innerHTML='<p style="text-align:center;color:var(--text-secondary);font-size:13px;margin:10px;">目前沒有設定長按選項</p>';return;}
    dataList.forEach((item,index)=>{const div=document.createElement('div');div.className='hint-item';div.draggable=true;div.ondragstart=(e)=>handleDragStart(e,index);div.ondragover=(e)=>handleDragOver(e,index);div.ondragleave=(e)=>handleDragLeave(e);div.ondrop=(e)=>handleDrop(e,index);div.ondragend=(e)=>handleDragEnd(e);
        let actionType='symbol',actionValue='';if(typeof item.action==='string'){actionType=item.action;}else if(item.action){if(item.action.symbol!==undefined){actionType='symbol';actionValue=item.action.symbol;}else if(item.action.character!==undefined){actionType='character';actionValue=item.action.character;}else if(item.action.sendKeys!==undefined){actionType='sendKeys';actionValue=item.action.sendKeys;}else if(item.action.shortcut!==undefined){if(reverseShortcutMap[item.action.shortcut]){actionType=reverseShortcutMap[item.action.shortcut];actionValue='';}else{actionType='shortcut';actionValue=item.action.shortcut;}}else if(item.action.keyboardType!==undefined){actionType='keyboardType';actionValue=item.action.keyboardType;}}
        let displayLabelText="";let previewSymbol="";if(item.label){if(item.label.systemImageName){displayLabelText="sf:"+item.label.systemImageName;previewSymbol=sfSymbolEmojiMap[item.label.systemImageName]||'❖';}else if(item.label.text){displayLabelText=item.label.text;previewSymbol=Array.from(displayLabelText)[0]||'';}}
        const showValueInput=!noValueCommands.includes(actionType)&&!actionType.startsWith('shortcut_');
        let actionValueHtml=`<input type="text" style="width:145px;" value="${actionValue}" onchange="updateHintItem(${index},'actionValue',this.value,false)">`;
        if(actionType==='shortcut'){let isMatched=shortCommandsGroups.flatMap(g=>g.options).some(c=>c.value===actionValue);let isCustom=item._isCustomUI||(!isMatched&&actionValue!=='');let optionsHtml=`<option value="" ${!actionValue&&!isCustom?'selected disabled':''}>選擇...</option>`;shortCommandsGroups.forEach(g=>{optionsHtml+=`<optgroup label="${g.group}">`+g.options.map(c=>`<option value="${c.value}" ${actionValue===c.value&&!isCustom?'selected':''}>${c.label}</option>`).join('')+`</optgroup>`;});optionsHtml+=`<option value="__custom__" ${isCustom?'selected':''}>自訂</option>`;actionValueHtml=`<div style="display:flex;flex-direction:column;gap:4px;width:145px;"><select style="width:145px;" onchange="updateHintShortcut(${index},this.value)">${optionsHtml}</select><input type="text" style="display:${isCustom?'block':'none'};width:145px;" placeholder="指令" value="${actionValue}" onchange="updateHintItem(${index},'actionValue',this.value,false)"></div>`;}
        else if(actionType==='keyboardType'){let isMatched=keyboardTypesList.some(kb=>kb.value===actionValue);let isCustom=item._isCustomKbUI||(!isMatched&&actionValue!=='');let optionsHtml=`<option value="" ${!actionValue&&!isCustom?'selected disabled':''}>請選擇鍵盤...</option>`;optionsHtml+=keyboardTypesList.map(kb=>`<option value="${kb.value}" ${actionValue===kb.value&&!isCustom?'selected':''}>${kb.label}</option>`).join('');optionsHtml+=`<option value="__custom__" ${isCustom?'selected':''}>自訂名稱</option>`;actionValueHtml=`<div style="display:flex;flex-direction:column;gap:4px;width:145px;"><select style="width:145px;" onchange="updateHintKeyboardType(${index},this.value)">${optionsHtml}</select><input type="text" style="display:${isCustom?'block':'none'};width:145px;" placeholder="輸入鍵盤名稱" value="${actionValue}" onchange="updateHintItem(${index},'actionValue',this.value,false)"></div>`;}
        let actionSelectHtml=`<select style="width:145px;" onchange="updateHintItem(${index},'actionType',this.value,true)"><optgroup label="常用快捷指令"><option value="shortcut_undo" ${actionType==='shortcut_undo'?'selected':''}>撤銷</option><option value="shortcut_deleteText" ${actionType==='shortcut_deleteText'?'selected':''}>全刪除</option><option value="shortcut_copy" ${actionType==='shortcut_copy'?'selected':''}>複製</option><option value="shortcut_paste" ${actionType==='shortcut_paste'?'selected':''}>貼上</option><option value="shortcut_cut" ${actionType==='shortcut_cut'?'selected':''}>剪下</option><option value="shortcut_selectText" ${actionType==='shortcut_selectText'?'selected':''}>全選</option><option value="shortcut_home" ${actionType==='shortcut_home'?'selected':''}>行首</option><option value="shortcut_end" ${actionType==='shortcut_end'?'selected':''}>行尾</option><option value="shortcut_onehanded" ${actionType==='shortcut_onehanded'?'selected':''}>單手</option><option value="shortcut_rime2" ${actionType==='shortcut_rime2'?'selected':''}>次選</option><option value="shortcut_rime3" ${actionType==='shortcut_rime3'?'selected':''}>三選</option></optgroup><optgroup label="獨立指令"><option value="backspace" ${actionType==='backspace'?'selected':''}>退格</option><option value="enter" ${actionType==='enter'?'selected':''}>回車</option><option value="shift" ${actionType==='shift'?'selected':''}>Shift</option><option value="tab" ${actionType==='tab'?'selected':''}>Tab</option><option value="space" ${actionType==='space'?'selected':''}>空格</option><option value="nextKeyboard" ${actionType==='nextKeyboard'?'selected':''}>地球</option><option value="characterMargin" ${actionType==='characterMargin'?'selected':''}>佔位</option><option value="none" ${actionType==='none'?'selected':''}>無</option></optgroup><optgroup label="需要設定值"><option value="character" ${actionType==='character'?'selected':''}>字符</option><option value="symbol" ${actionType==='symbol'?'selected':''}>符號</option><option value="sendKeys" ${actionType==='sendKeys'?'selected':''}>組合鍵</option><option value="shortcut" ${actionType==='shortcut'?'selected':''}>自訂命令</option><option value="keyboardType" ${actionType==='keyboardType'?'selected':''}>鍵盤</option></optgroup></select>`;
        div.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:8px;padding-bottom:8px;border-bottom:1px dashed var(--border);"><span class="hint-index-badge" title="拖曳以改變順序">選項 [${index}] ↕️</span><button class="btn btn-red btn-sm" onclick="removeHintItem(${index})">🗑️ 刪除</button></div><div class="input-row" style="margin-bottom:4px;"><label>輸出類型:</label>${actionSelectHtml}</div><div class="input-row" style="margin-bottom:4px;display:${showValueInput?'flex':'none'};"><label>輸出內容:</label>${actionValueHtml}</div><div class="input-row" style="margin-bottom:4px;"><label>鍵盤顯示:</label><div style="display:flex;gap:4px;align-items:center;"><div class="sf-input-container" style="width:115px;"><div class="sf-preview-box">${previewSymbol}</div><input type="text" class="sf-label-input" value="${displayLabelText}" onchange="updateHintItemLabel(${index},this.value)" placeholder="sf:..."></div><button class="btn btn-ghost btn-sm" style="padding:0;width:26px;height:32px;" onclick="openIconModal(${index})" title="選擇圖示">🔍</button></div></div>`;
        container.appendChild(div);});
}

window.updateHintShortcut=function(index,value){const catsToUpdate=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];if(value==='__custom__'){catsToUpdate.forEach(cat=>hintSymbolsData[cat][currentSelectedKey].list[index]._isCustomUI=true);updateHintItem(index,'actionValue','',true);}else{catsToUpdate.forEach(cat=>hintSymbolsData[cat][currentSelectedKey].list[index]._isCustomUI=false);const matchedCmd=shortCommandsGroups.flatMap(g=>g.options).find(c=>c.value===value);if(matchedCmd){updateHintItemLabel(index,matchedCmd.label);}updateHintItem(index,'actionValue',value,true);}};
window.updateHintKeyboardType=function(index,value){const catsToUpdate=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];if(value==='__custom__'){catsToUpdate.forEach(cat=>hintSymbolsData[cat][currentSelectedKey].list[index]._isCustomKbUI=true);updateHintItem(index,'actionValue','',true);}else{catsToUpdate.forEach(cat=>hintSymbolsData[cat][currentSelectedKey].list[index]._isCustomKbUI=false);const matchedKb=keyboardTypesList.find(k=>k.value===value);if(matchedKb){updateHintItemLabel(index,matchedKb.label.split(' ')[0]);}updateHintItem(index,'actionValue',value,true);}};
window.updateHintItemLabel=function(index,value){const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(!hintSymbolsData[cat][currentSelectedKey].list[index])hintSymbolsData[cat][currentSelectedKey].list[index]={action:{symbol:''}};const item=hintSymbolsData[cat][currentSelectedKey].list[index];let v=value.trim();if(v){item.label={};if(v.toLowerCase().startsWith('sf:')){item.label.systemImageName=v.substring(3).trim();}else{item.label.text=v;}}else{item.label={text:""};}});renderHintItems();}
window.updateHintItem=function(index,field,value,forceRender){const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(!hintSymbolsData[cat][currentSelectedKey].list[index])hintSymbolsData[cat][currentSelectedKey].list[index]={action:{symbol:''},label:{text:''}};const item=hintSymbolsData[cat][currentSelectedKey].list[index];let actionType=typeof item.action==='string'?item.action:(item.action?Object.keys(item.action)[0]:'symbol');let aVal=typeof item.action==='string'?'':(item.action?item.action[actionType]:'');if(item.action&&item.action.shortcut){if(reverseShortcutMap[item.action.shortcut]){actionType=reverseShortcutMap[item.action.shortcut];}else{actionType='shortcut';}}if(field==='actionType'){actionType=value;if(noValueCommands.includes(actionType)||actionType.startsWith('shortcut_'))aVal='';if(actionType==='shortcut'){aVal='';item._isCustomUI=false;}if(actionType==='keyboardType'){aVal='';item._isCustomKbUI=false;}if(actionType.startsWith('shortcut_')){item.action={"shortcut":presetShortcuts[actionType]};}else if(noValueCommands.includes(actionType)){item.action=actionType;}else{item.action={};item.action[actionType]=aVal;}if(commandToSfMap[actionType]){item.label={systemImageName:commandToSfMap[actionType].substring(3).trim()};}else{item.label={text:""};}}else if(field==='actionValue'){aVal=value;if(!actionType.startsWith('shortcut_')&&!noValueCommands.includes(actionType)){item.action={};item.action[actionType]=aVal;}}});if(forceRender)renderHintItems();};
window.addHintItem=function(){const newItem={action:{symbol:''},label:{text:''}};const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(!hintSymbolsData[cat][currentSelectedKey].list)hintSymbolsData[cat][currentSelectedKey].list=[];hintSymbolsData[cat][currentSelectedKey].list.push(JSON.parse(JSON.stringify(newItem)));});renderHintItems();};
window.removeHintItem=function(index){const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(hintSymbolsData[cat][currentSelectedKey].list[index])hintSymbolsData[cat][currentSelectedKey].list.splice(index,1);});renderHintItems();};

function silentSaveCurrentKey(){if(!currentSelectedKey)return;const nUp=buildSwipeNode('up',swipeData.swipe_up[currentSelectedKey]);if(nUp)swipeData.swipe_up[currentSelectedKey]=nUp;else delete swipeData.swipe_up[currentSelectedKey];const nDown=buildSwipeNode('down',swipeData.swipe_down[currentSelectedKey]);if(nDown)swipeData.swipe_down[currentSelectedKey]=nDown;else delete swipeData.swipe_down[currentSelectedKey];const idx=parseInt(document.getElementById('selectedIndexInput').value)||0;const widthVal=parseInt(document.getElementById('hintWidthInput').value)||0;const cats=currentCategory==='both'?['alphabetic','pinyin']:[currentCategory];cats.forEach(cat=>{if(hintSymbolsData[cat]&&hintSymbolsData[cat][currentSelectedKey]){hintSymbolsData[cat][currentSelectedKey].selectedIndex=idx;if(widthVal>0){hintSymbolsData[cat][currentSelectedKey].size={width:widthVal,height:53};}else{delete hintSymbolsData[cat][currentSelectedKey].size;}if(hintSymbolsData[cat][currentSelectedKey].list.length===0)delete hintSymbolsData[cat][currentSelectedKey];}});}
function saveKeyData(){if(!currentSelectedKey)return;silentSaveCurrentKey();renderKeyboard();updateCodeOutput();const btn=document.getElementById('mainSaveBtn');const originalText=btn.innerText;btn.innerText='✅ 更新成功！已產出最新程式碼';setTimeout(()=>btn.innerText=originalText,3000);}
function batchUpdate(direction){if(currentSelectedKey)silentSaveCurrentKey();const sizeStr=document.getElementById(direction==='up'?'batchUpSize':'batchDownSize').value;const color=document.getElementById(direction==='up'?'batchUpColor':'batchDownColor').value;const size=sizeStr?parseInt(sizeStr):null;const targetData=direction==='up'?swipeData.swipe_up:swipeData.swipe_down;for(let key in targetData){if(targetData.hasOwnProperty(key)){if(size!==null)targetData[key].fontSize=size;if(color.toLowerCase()!=='#8e8e93'){targetData[key].normalColor=targetData[key].highlightColor=color;}}}renderKeyboard();updateCodeOutput();if(currentSelectedKey)selectKey(currentSelectedKey);}
function switchCodeTab(tab){activeCodeTab=tab;document.getElementById('tabBtnSwipe').className=tab==='swipe'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('tabBtnHint').className=tab==='hint'?'btn btn-primary btn-sm':'btn btn-ghost btn-sm';document.getElementById('codeTitle').innerText=tab==='swipe'?'程式碼預覽 ('+fileNames.swipe+')':'程式碼預覽 ('+fileNames.hint+')';updateCodeOutput();}
function updateCodeOutput(){if(activeCodeTab==='swipe'){document.getElementById('codeOutput').value="// === 本配置檔由鍵盤配置工作室產出 ===\n\n"+JSON.stringify(swipeData,null,2);}else{let cleanData=JSON.parse(JSON.stringify(hintSymbolsData));Object.keys(cleanData).forEach(c=>Object.keys(cleanData[c]).forEach(k=>{if(cleanData[c][k].list){cleanData[c][k].list.forEach(i=>{delete i._isCustomUI;delete i._isCustomKbUI;if(!i.label){i.label={text:""};}else if(Object.keys(i.label).length===0){i.label={text:""};}});}}));let out=JSON.stringify(cleanData,null,2).replace(/"([a-zA-Z_][a-zA-Z0-9_]*)\":/g,'$1:');document.getElementById('codeOutput').value="// === 本配置檔由鍵盤配置工作室產出 ===\n\n{\n"+out.substring(1,out.length-1)+"\n}";}}

function setupDropZone(dzId,inputId,textId,type,callback){const dz=document.getElementById(dzId),input=document.getElementById(inputId);dz.onclick=()=>input.click();dz.ondragover=e=>{e.preventDefault();dz.classList.add('dragover');};dz.ondragleave=()=>dz.classList.remove('dragover');dz.ondrop=e=>{e.preventDefault();dz.classList.remove('dragover');if(e.dataTransfer.files.length){if(type==='swipe')fileNames.swipe=e.dataTransfer.files[0].name;if(type==='hint')fileNames.hint=e.dataTransfer.files[0].name;callback(e.dataTransfer.files[0],textId);}};input.onchange=e=>{if(e.target.files.length){if(type==='swipe')fileNames.swipe=e.target.files[0].name;if(type==='hint')fileNames.hint=e.target.files[0].name;callback(e.target.files[0],textId);}input.value='';};}
function showBtnMsg(btnId,defaultText,msg){const b=document.getElementById(btnId);b.innerText=msg;setTimeout(()=>b.innerText=defaultText,2000);}
window.handlePanelCopy=function(type){if(currentSelectedKey){silentSaveCurrentKey();updateCodeOutput();renderKeyboard();}if(activeCodeTab!==type)switchCodeTab(type);const text=document.getElementById('codeOutput').value;internalClipboard[type]=text;const btnId=type==='swipe'?'copySwipeBtn':'copyHintBtn';const defaultText=type==='swipe'?'📄 複製上下滑配置':'📄 複製長按配置';if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(()=>showBtnMsg(btnId,defaultText,'✅ 複製成功')).catch(()=>showBtnMsg(btnId,defaultText,'✅ 暫存複製'));}else{showBtnMsg(btnId,defaultText,'✅ 暫存複製');}};
window.handlePanelPaste=async function(type){let txt="";try{if(navigator.clipboard&&navigator.clipboard.readText)txt=await navigator.clipboard.readText();}catch(err){}if(!txt)txt=internalClipboard[type];const btnId=type==='swipe'?'pasteSwipeBtn':'pasteHintBtn';const defaultText=type==='swipe'?'📋 貼上上下滑配置':'📋 貼上長按配置';if(!txt){showBtnMsg(btnId,defaultText,'❌ 無內容可貼上');return;}try{if(type==='swipe'){swipeData=parseDataFile(txt);step2Loaded=true;}else{hintSymbolsData=parseDataFile(txt);migrateOldCommands(hintSymbolsData);step3Loaded=true;}if(activeCodeTab!==type)switchCodeTab(type);renderKeyboard();updateCodeOutput();if(currentSelectedKey)selectKey(currentSelectedKey);showBtnMsg(btnId,defaultText,'✅ 貼上成功');}catch(e){showBtnMsg(btnId,defaultText,'❌ 解析失敗');}};
